{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "bottom",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "xava.app-taskbar",
          "activeIndicator": "Underline",
          "excludedClasses": "",
          "leadingSeparator": true,
          "maxLabelLength": 14,
          "maxRunningWindows": 12,
          "pinnedApps": "[{\"label\":\"Zen\",\"match\":\"^zen$\",\"launch\":\"omarchy-launch-browser\",\"icon\":\"zen-browser\",\"desktopId\":\"zen\"},{\"label\":\"Cursor\",\"match\":\"^cursor$\",\"launch\":\"uwsm-app -- gtk-launch 'cursor.desktop'\",\"icon\":\"co.anysphere.cursor\",\"desktopId\":\"cursor\"}]",
          "sectionSeparator": true,
          "showIcons": true,
          "showLabels": true,
          "showRunning": true
        }
      ],
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": [
            "discord_status_icon_1"
          ],
          "hidden": []
        },
        {
          "id": "stappmus.activity-monitor",
          "samplingSpeed": "Fast"
        },
        {
          "id": "akitaonrails.ai-usagebar"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "io.github.pablo-merino.altswitch"
    }
  ]
}
