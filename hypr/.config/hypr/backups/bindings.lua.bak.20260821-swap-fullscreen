-- Keep personal bindings independent of optional Omarchy plugins.
o.bind("SUPER + M", "Minimize window", hl.dsp.window.move({
  workspace = "special:omarchy-minimized",
  follow = false,
}))

o.bind("SHIFT + ALT + S", "Screenshot", "omarchy-capture-screenshot")
o.bind("CTRL + Q", "Close window", hl.dsp.window.close())

-- Open Omarchy's web shortcuts as regular tabs in the default browser (Zen).
local function bind_browser_tab(shortcut, description, url)
  hl.unbind(shortcut)
  o.bind(shortcut, description .. " (browser tab)", "omarchy-launch-browser " .. string.format("%q", url))
end

bind_browser_tab("SUPER + SHIFT + A", "ChatGPT", "https://chatgpt.com")
