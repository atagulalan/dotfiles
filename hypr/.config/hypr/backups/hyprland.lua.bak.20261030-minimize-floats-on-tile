-- Header double-click sends a client maximize. Undo that and toggle float.
-- Super+F sets hypr_keybind_fullscreen so a real maximize still goes through.
local client_maximize_pending = {}

local function window_address(window)
  local addr = window and window.address
  if not addr or addr == "" then
    return nil
  end
  addr = tostring(addr)
  if addr:sub(1, 2) ~= "0x" then
    addr = "0x" .. addr
  end
  return addr
end

hl.on("window.fullscreen", function(window)
  if hypr_keybind_fullscreen or not window then
    return
  end

  local state = window.fullscreen
  local client = window.fullscreen_client
  if state == 2 or state == true then
    return
  end
  if state ~= 1 and client ~= 1 then
    return
  end

  local addr = window_address(window)
  if not addr or client_maximize_pending[addr] then
    return
  end

  client_maximize_pending[addr] = true
  hl.timer(function()
    client_maximize_pending[addr] = nil

    local target = nil
    local list = hl.get_windows()
    for i = 1, #list do
      if window_address(list[i]) == addr then
        target = list[i]
        break
      end
    end
    if not target then
      return
    end

    if target.fullscreen == 1 then
      hypr_keybind_fullscreen = true
      hl.dispatch(hl.dsp.window.fullscreen({ mode = "maximized", window = target }))
      hypr_keybind_fullscreen = false
    end

    hl.dispatch(hl.dsp.window.float({ action = "toggle", window = target }))
  end, { timeout = 1, type = "oneshot" })
end)

require("hypr.macos-fullscreen")

